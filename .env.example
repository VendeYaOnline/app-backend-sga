# =============================================================================
# SGA - Sistema de Gestión Administrativa
# Variables de entorno
# =============================================================================
# Copiar este archivo como .env y reemplazar los valores con los reales.

# ---- Base de datos SQL Server ----
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=TU_PASSWORD
DB_NAME=TDH_Automatic

# ---- JWT ----
JWT_SECRET=clave-secreta-alta-entropia-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# ---- Storage de archivos ----
STORAGE_ROOT=C:/sga-storage

# ---- SMTP (notificaciones por correo) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sga.cl
SMTP_PASS=TU_PASSWORD_EMAIL

# ---- CORS ----
CORS_ORIGIN=http://localhost:4200

# ---- App ----
PORT=3000
NODE_ENV=development

# ---- Setup inicial (primer administrador) ----
# Token requerido por POST /auth/setup para crear el admin inicial.
# Solo funciona si no existe un administrador previo en el sistema.
SETUP_SECRET=cambiar-por-un-valor-seguro
